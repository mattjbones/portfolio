<!DOCTYPE html>
<html lang="en">
<head>
  {% include 'head' %}
</head>
<body class="site-page">
  <header class="site-header">
    {% include 'nav' %}
  </header>
  <main class="site-main">
    {{ content }}
  </main>
  <footer class="site-footer">
    &copy; {{ site.time | date: "%Y" }} <a class="site-footer-link" href="https://mastodon.social/@{{ site.author.username }}" rel="me noopener" target="_blank">{{ site.author.name }}</a>
  </footer>
</body>
</html>
